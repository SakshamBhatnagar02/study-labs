# Supabase Configuration
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key
EXPO_PUBLIC_SUPABASE_KEY=your-supabase-key

# Gemini AI API Configuration
EXPO_PUBLIC_GEMINI_API_KEY=your-gemini-api-key

# Email Service (Resend - https://resend.com)
EXPO_PUBLIC_RESEND_API_KEY=re_your_resend_api_key
RESEND_API_KEY=re_your_resend_api_key

# Abstract API (Disposable Email & Email Reputation - https://www.abstractapi.com/api/email-reputation)
EXPO_PUBLIC_ABSTRACT_EMAIL_API_KEY=your_abstract_email_api_key
ABSTRACT_EMAIL_API_KEY=your_abstract_email_api_key

# Backblaze B2 Storage (https://www.backblaze.com/b2/cloud-storage.html)
EXPO_PUBLIC_B2_KEY_ID=your_b2_key_id
EXPO_PUBLIC_B2_KEY_NAME=Master Application Key
EXPO_PUBLIC_B2_APPLICATION_KEY=your_b2_application_key
B2_KEY_ID=your_b2_key_id
B2_APPLICATION_KEY=your_b2_application_key

# Cloudflare Configuration (Turnstile & R2 Storage - https://dash.cloudflare.com)
EXPO_PUBLIC_CLOUDFLARE_TURNSTILE_SITE_KEY=your_turnstile_site_key
EXPO_PUBLIC_CLOUDFLARE_R2_BUCKET=studylabs-media
EXPO_PUBLIC_CLOUDFLARE_R2_ACCOUNT_ID=your_cloudflare_account_id

# Application Metadata
EXPO_PUBLIC_APP_ID=io.study.labs
EXPO_PUBLIC_ENV=development

# OAuth Provider Configuration (GitHub, Microsoft Entra, Google)
EXPO_PUBLIC_GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

EXPO_PUBLIC_MICROSOFT_CLIENT_ID=your_microsoft_client_id
EXPO_PUBLIC_MICROSOFT_TENANT_ID=your_microsoft_tenant_id
MICROSOFT_CLIENT_SECRET=your_microsoft_client_secret

EXPO_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_PROJECT_ID=your_google_project_id


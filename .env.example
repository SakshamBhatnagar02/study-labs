# Supabase Configuration (Free Tier / Development)
# Replace with your project details from https://app.supabase.com
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key

# Gemini AI API Configuration
# Get your free development key from https://aistudio.google.com/app/apikey
EXPO_PUBLIC_GEMINI_API_KEY=your-gemini-api-key

# Application Metadata
EXPO_PUBLIC_APP_ID=io.study.labs
EXPO_PUBLIC_ENV=development
